{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "src/test/setup.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "prettier.config.mjs",
    "eslint.config.js",
    "commitlint.config.mjs",
    "wdio.conf.ts",
    "e2e/specs/**/*.e2e.ts"
  ],
